{
    "name": "fantager/fantager",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "symfony/framework-bundle": "^8.1.10",
        "symfony/console": "^8.1.10",
        "symfony/apache-pack": "^1.0.1",
        "symfony/yaml": "^8.1.10",
        "symfony/webpack-encore-bundle": "^2.4.2",
        "symfony/ux-turbo": "^3.6",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "^8.1.10",
        "symfony/twig-bundle": "^8.1.9",
        "symfony/security-bundle": "^8.1.10",
        "symfony/rate-limiter": "^8.1.10",
        "symfony/mailer": "^8.1.10",
        "symfony/messenger": "^8.1.10",
        "doctrine/dbal": "^4.5",
        "symfony/doctrine-messenger": "^8.1.10",
        "doctrine/orm": "^3.7.5",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "symfony/dotenv": "^8.1.6",
        "sentry/sentry-symfony": "^5.15",
        "symfony/flex": "^2.12",
        "symfony/monolog-bundle": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "init-db": [
            "php bin/console doctrine:schema:create --no-interaction",
            "php bin/console messenger:setup-transports --no-interaction",
            "php bin/console doctrine:migrations:sync-metadata-storage --no-interaction"
        ],
        "migrate": "php bin/console doctrine:migrations:migrate --no-interaction",
        "migrate-diff": "php bin/console doctrine:migrations:diff",
        "cache-clear": "php bin/console cache:clear",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "php-cs": "vendor/bin/php-cs-fixer check --diff",
        "php-cs-fix": "vendor/bin/php-cs-fixer fix --diff",
        "test": "vendor/bin/phpunit",
        "kingdom": "php bin/console app:kingdom:initialize \"Main Kingdom\" --pace=test --test --start-offset-days=-10",
        "ticks": "php bin/console app:ticks:run",
        "ticks-week": "php bin/console app:ticks:run --advance=\"+1 week\"",
        "ticks-session": "php bin/console app:ticks:run --advance=\"+10 week\"",
        "messenger": "php bin/console messenger:consume async --limit=2000 -vv",
        "users": "php bin/console app:user:create-test \"Main Kingdom\" --default",
        "new-kingdom": [
            "@init-db",
            "@kingdom",
            "@ticks"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5",
        "symfony/debug-bundle": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1.10",
        "phpstan/phpstan-phpunit": "^2.1.1"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*"
        }
    }
}
