{# templates/components/hero/equipped_gear.html.twig #}
<div class="hero-panel">
    <div class="hero-panel__header">
        <div>
            <h2 class="hero-panel__title">{{ 'heroes.equipped_gear'|trans }}</h2>
            <p class="hero-panel__desc">{{ 'heroes.equipped_gear_desc'|trans }}</p>
        </div>
        <a href="{{ path('app_heroes_detail', { id: hero.id, tab: 'equipment' }) }}" class="btn btn-outline btn--sm btn--icon-lead">
            🎒 {{ 'heroes.manage_gear'|trans }}
        </a>
    </div>

    <div class="hero-gear-grid">
        {% set slot_configs = [
            {key: 'head', emoji: '🪖'},
            {key: 'amulet', emoji: '📿'},
            {key: 'body', emoji: '🛡️'},
            {key: 'hands', emoji: '🧤'},
            {key: 'main_hand', emoji: '⚔️'},
            {key: 'off_hand', emoji: '🛡️'},
            {key: 'ring', emoji: '💍'},
            {key: 'ring_2', emoji: '💍'},
            {key: 'feet', emoji: '🥾'}
        ] %}
        {% set main_item = equipped['main_hand'] ?? null %}
        {% set off_blocked = main_item is not null and main_item.subType is not null and main_item.subType.occupiesBothHands %}

        {% for slot in slot_configs %}
            {% set item = equipped[slot.key] ?? null %}
            {% if item %}
                {# Active Item Slot #}
                <button type="button" onclick="document.querySelector('[data-tab=\'hero-tab-equipment\']').click()" class="hero-gear-slot hero-gear-slot--filled hero-gear-slot--clickable">
                    <span class="hero-gear-slot__label">{{ ('inventory.slot_' ~ slot.key)|trans }}</span>
                    <span class="hero-gear-slot__icon">
                        {% if item.slotType.value == 'main_hand' or item.slotType.value == 'weapon' %}🗡️
                        {% elseif item.slotType.value == 'head' %}🪖
                        {% elseif item.slotType.value == 'body' %}🛡️
                        {% elseif item.slotType.value == 'ring' %}💍
                        {% else %}🎒{% endif %}
                    </span>
                    <span class="hero-gear-slot__name" title="{{ item_display_name(item) }}">{{ item_display_name(item) }}</span>
                    <span class="rarity-tag rarity-tag--{{ item.rarity.value }}">
                        {{ ('inventory.rarity_' ~ item.rarity.value)|trans }}
                    </span>
                </button>
            {% else %}
                {% set blocked = slot.key == 'off_hand' and off_blocked %}
                {% set race_hint = item_slot_race_hint(hero, slot.key) %}
                {# Empty Slot Placeholder #}
                <button type="button" onclick="document.querySelector('[data-tab=\'hero-tab-equipment\']').click()" class="hero-gear-slot hero-gear-slot--empty{% if blocked or race_hint %} hero-gear-slot--blocked{% endif %}">
                    <span class="hero-gear-slot__label hero-gear-slot__label--faint">{{ ('inventory.slot_' ~ slot.key)|trans }}</span>
                    <span class="hero-gear-slot__icon">{{ slot.emoji }}</span>
                    <span class="hero-gear-slot__empty-hint"{% if race_hint %} title="{{ race_hint }}"{% endif %}>
                        {% if race_hint %}
                            {{ 'inventory.slot_race_restricted'|trans }}
                        {% else %}
                            {{ (blocked ? 'inventory.slot_two_hand_held' : 'inventory.empty_slot')|trans }}
                        {% endif %}
                    </span>
                </button>
            {% endif %}
        {% endfor %}
    </div>
</div>
