{# templates/components/hero/weapon_mastery.html.twig #}

{# Weapon style icon mapping #}
{% set weapon_style_icons = {
    one_handed_sword: '🗡️',
    two_handed_sword: '⚔️',
    one_handed_axe: '🪓',
    two_handed_axe: '🪓',
    one_handed_mace: '🔨',
    two_handed_mace: '🔨',
    dagger: '🗡️',
    bow: '🏹',
    crossbow: '🏹',
    wand: '🪄',
    staff: '🪄',
    shield: '🛡️',
    spell_accelerator: '🌀',
    light_armor: '👕',
    medium_armor: '🛡️',
    heavy_armor: '🧥'
} %}

{#
  Macro: render a single mastery row.
  Used in both the equipped section and the full grid to avoid duplication.
#}
{% macro mastery_row(style_label, wm_tier, wm_xp, is_inactive, icon, is_equipped) %}
    {% set relative_xp  = wm_xp %}
    {% set relative_req = 100 %}
    {% if wm_tier == 2 %}
        {% set relative_xp  = wm_xp - 100 %}
        {% set relative_req = 200 %}
    {% elseif wm_tier == 3 %}
        {% set relative_xp  = wm_xp - 300 %}
        {% set relative_req = 300 %}
    {% elseif wm_tier == 4 %}
        {% set relative_xp  = wm_xp - 600 %}
        {% set relative_req = 400 %}
    {% elseif wm_tier == 5 %}
        {% set relative_xp  = 1 %}
        {% set relative_req = 1 %}
    {% endif %}

    {% set progress_pct = wm_tier == 5 ? 100 : (relative_xp / relative_req * 100)|round(0, 'floor') %}

    <div class="hero-mastery-row {{ is_equipped ? 'hero-mastery-row--equipped' }} {{ is_inactive ? 'hidden' }}"
         {{ is_inactive ? 'data-mastery-toggle-target="item"' }}>
        <div class="hero-mastery-row__info">
            <span class="hero-mastery-row__icon">{{ icon }}</span>
            <span class="hero-mastery-row__name" title="{{ style_label }}">{{ style_label }}</span>
        </div>
        <div class="hero-mastery-row__progress">
            <div class="ui-progress ui-progress--compact hero-mastery-row__bar-track">
                <div class="ui-progress__fill ui-progress__fill--accent" style="--ui-progress-pct: {{ progress_pct }}%"></div>
            </div>
            <span class="hero-mastery-row__pct">{{ progress_pct }}%</span>
        </div>
        <div class="hero-mastery-row__meta">
            {% if wm_tier == 5 %}
                <span>{{ 'heroes.mastery_xp_max'|trans }}</span>
            {% else %}
                <span>{{ relative_xp }}/{{ relative_req }} XP</span>
            {% endif %}
            <span class="hero-mastery-row__tier">T{{ wm_tier }}</span>
        </div>
    </div>
{% endmacro %}

<div class="hero-panel" data-controller="mastery-toggle">
    <div>
        <h2 class="hero-panel__title">{{ 'heroes.gear_mastery'|trans }}</h2>
    </div>

    {# Build deduplicated list of currently equipped sub-types #}
    {% set equipped_masteries = [] %}
    {% for slot, item in equipped %}
        {% if item.subType and item.subType.value not in equipped_masteries %}
            {% set equipped_masteries = equipped_masteries|merge([item.subType.value]) %}
        {% endif %}
    {% endfor %}

    {% set active_count = 0 %}
    {% for wm in hero.weaponMasteries %}
        {% if wm.xp > 0 or wm.masteryTier > 1 or wm.style.value in equipped_masteries %}
            {% set active_count = active_count + 1 %}
        {% endif %}
    {% endfor %}

    {% set categories = [
        {
            id: 'melee',
            label: 'heroes.mastery_cat_melee'|trans,
            icon: '⚔️',
            styles: ['one_handed_sword', 'two_handed_sword', 'one_handed_axe', 'two_handed_axe', 'one_handed_mace', 'two_handed_mace', 'dagger']
        },
        {
            id: 'ranged',
            label: 'heroes.mastery_cat_ranged'|trans,
            icon: '🏹',
            styles: ['bow', 'crossbow']
        },
        {
            id: 'magic',
            label: 'heroes.mastery_cat_magic'|trans,
            icon: '🪄',
            styles: ['wand', 'staff', 'spell_accelerator']
        },
        {
            id: 'defense',
            label: 'heroes.mastery_cat_defense'|trans,
            icon: '🛡️',
            styles: ['shield', 'light_armor', 'medium_armor', 'heavy_armor']
        }
    ] %}

    <div class="hero-mastery-categories">
        {% for cat in categories %}
            {% set cat_styles = [] %}
            {% for style in cat.styles %}
                {% set wm_tier = 1 %}
                {% set wm_xp  = 0 %}
                {% for wm in hero.weaponMasteries %}
                    {% if wm.style.value == style %}
                        {% set wm_tier = wm.masteryTier %}
                        {% set wm_xp   = wm.xp %}
                    {% endif %}
                {% endfor %}
                {% set cat_styles = cat_styles|merge([{
                    style: style,
                    wm_tier: wm_tier,
                    wm_xp: wm_xp,
                    is_equipped: style in equipped_masteries
                }]) %}
            {% endfor %}

            {# Sort descending by wm_xp #}
            {% set sorted_styles = cat_styles|sort((a, b) => b.wm_xp <=> a.wm_xp) %}

            {% if sorted_styles|length > 0 %}
                <div class="hero-mastery-category">
                    <h4 class="hero-mastery-category__title">{{ cat.icon }} {{ cat.label }}</h4>
                    <div class="hero-mastery-list">
                        {% for item in sorted_styles %}
                            {% set is_inactive = not (item.wm_xp > 0 or item.wm_tier > 1 or item.is_equipped) %}
                            {% set style_icon = weapon_style_icons[item.style]|default('⚔️') %}
                            {{ _self.mastery_row(('weapon_style.' ~ item.style)|trans, item.wm_tier, item.wm_xp, is_inactive, style_icon, item.is_equipped) }}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>

    {% if active_count < hero.weaponMasteries|length %}
        <div class="layout-cluster layout-cluster--center">
            <button type="button" class="btn btn-outline btn--sm btn--spaced-top" data-action="click->mastery-toggle#toggle"
                    data-toggle-text="{{ 'heroes.btn_hide_inactive_masteries'|trans }}">
                {{ 'heroes.btn_show_all_masteries'|trans }}
            </button>
        </div>
    {% endif %}
</div>
