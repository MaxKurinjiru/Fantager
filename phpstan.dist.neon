includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Auto-generated by Symfony; PHPStan treats nested @psalm-type aliases as missing classes
        - config/reference.php
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: /tmp/fantager/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: bin/object-manager.php
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # findBy/findOneBy/count criteria still use kingdom/tickType/scheduledAt; those
        # columns live on KingdomTickEvent and KingdomTickLogRepository joins them.
        -
            identifier: doctrine.findOneByArgument
            message: '#KingdomTickLog does not have a field named \$(kingdom|scheduledAt|tickType)#'
        -
            identifier: doctrine.findByArgument
            message: '#KingdomTickLog does not have a field named \$(kingdom|scheduledAt|tickType)#'
        -
            identifier: doctrine.countArgument
            message: '#KingdomTickLog does not have a field named \$kingdom#'
        -
            identifier: method.nonObject
            path: tests/Repository/KingdomTickLogRepositoryTest.php
        -
            identifier: argument.type
            path: tests/Repository/KingdomTickLogRepositoryTest.php
