{# templates/components/item/rucksack_items.html.twig #}
<div class="inventory-rucksack">
    <h2 class="hero-panel__title">{{ 'inventory.rucksack'|trans }}</h2>

    <div class="rucksack-list">
        {% for item in items %}
            {% set is_equipped = item.equippedHero is not null %}
            {% set is_equipped_on_selected = selected_hero and is_equipped and item.equippedHero.id == selected_hero.id %}

            <div class="rucksack-item rucksack-item--rarity-{{ item.rarity.value }}">
                <div class="rucksack-item__main">
                    <span class="rucksack-item__icon">
                        {% if item.slotType.value == 'main_hand' or item.slotType.value == 'weapon' %}🗡️
                        {% elseif item.slotType.value == 'off_hand' %}🛡️
                        {% elseif item.slotType.value == 'head' %}🪖
                        {% elseif item.slotType.value == 'body' %}🧥
                        {% elseif item.slotType.value == 'hands' %}🧤
                        {% elseif item.slotType.value == 'feet' %}🥾
                        {% elseif item.slotType.value == 'amulet' %}📿
                        {% elseif item.slotType.value == 'ring' %}💍
                        {% else %}🎒{% endif %}
                    </span>
                    <div class="rucksack-item__details">
                        <h3 class="rucksack-item__name">{{ item.name }}</h3>
                        <div class="rucksack-item__meta">
                            <span class="rarity-tag rarity-tag--{{ item.rarity.value }}">{{ ('inventory.rarity_' ~ item.rarity.value)|trans }}</span>
                            <span class="item-slot-tag">{{ ('inventory.slot_' ~ item.slotType.value)|trans }}</span>
                            <span class="item-durability-badge {% if item.durability < 100 %}item-durability-badge--low{% endif %}">
                                {{ 'inventory.durability'|trans }}: {{ item.durability }}%
                            </span>
                        </div>
                        {% set has_bonuses = false %}
                        {% for stat, bonus in item.bonuses %}
                            {% if (bonus ~ '') matches '/^-?[0-9]/' %}
                                {% set has_bonuses = true %}
                            {% endif %}
                        {% endfor %}
                        {% if has_bonuses %}
                            <div class="rucksack-item__bonuses">
                                {% for stat, bonus in item.bonuses %}
                                    {% if (bonus ~ '') matches '/^-?[0-9]/' %}
                                        <span class="item-bonus-tag">
                                            {{ ('inventory.stat_' ~ stat)|trans({}, null, null)|default(stat|upper) }}: <strong class="item-bonus-tag__value">+{{ bonus }}</strong>
                                        </span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="rucksack-item__actions">
                    {# Repair option if durability < 100 #}
                    {% if item.durability < 100 %}
                        <button type="button" data-action="click->equipment#repair" data-item-id="{{ item.id }}"
                                class="btn btn-outline-warning btn--sm">
                            {{ 'inventory.repair'|trans }}
                        </button>
                    {% endif %}

                    {# Dismantle option if NOT equipped #}
                    {% if not is_equipped %}
                        <button type="button" data-action="click->equipment#dismantle" data-item-id="{{ item.id }}"
                                class="btn btn-outline-danger btn--sm">
                            {{ 'inventory.dismantle'|trans }}
                        </button>
                    {% endif %}

                    {# Equip to selected hero #}
                    {% if selected_hero and not is_equipped %}
                        <button type="button" data-action="click->equipment#equip" data-item-id="{{ item.id }}" data-slot="{{ item.slotType.value }}"
                                class="btn btn-primary btn--sm">
                            {{ 'inventory.equip_slot_btn'|trans }}
                        </button>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="item-empty-state">
                <span class="emoji-icon emoji-icon--xl item-empty-state__icon">📭</span>
                <h4 class="item-empty-state__title">{{ 'inventory.rucksack_empty'|trans }}</h4>
                <p class="hero-panel__desc">{{ 'inventory.rucksack_empty_desc'|trans }}</p>
            </div>
        {% endfor %}
    </div>
</div>
