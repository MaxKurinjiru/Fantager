includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Auto-generated by Symfony; PHPStan treats nested @psalm-type aliases as missing classes
        - config/reference.php
    tmpDir: var/cache/phpstan
    symfony:
        containerXmlPath: /tmp/fantager/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: bin/object-manager.php
    reportUnmatchedIgnoredErrors: false
