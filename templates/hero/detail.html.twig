{% extends 'layouts/game.html.twig' %}

{% block title %}{{ 'heroes.details_title'|trans }} — {{ hero.name }} — Fantager{% endblock %}

{% block body %}
{% set hero_tabs = [
    { id: 'overview', label: 'heroes.tab_overview', emoji: '📋' },
    { id: 'equipment', label: 'heroes.tab_equipment', emoji: '🎒' },
    { id: 'spells', label: 'heroes.tab_spells', emoji: '📖' },
    { id: 'history', label: 'heroes.tab_history', emoji: '📊' }
] %}

{% set equipped_spells = {} %}
{% set known_spell_ids = [] %}
{% set masteries = {} %}
{% for hs in hero.heroSpells %}
    {% set known_spell_ids = known_spell_ids|merge([hs.spell.id]) %}
    {% if hs.isEquipped %}
        {% set equipped_spells = equipped_spells|merge({(hs.slotNumber): hs}) %}
    {% endif %}
{% endfor %}
{% for sm in hero.schoolMasteries %}
    {% set masteries = masteries|merge({(sm.school.value): sm.masteryTier}) %}
{% endfor %}

<div class="hero-detail-page page-shell" data-controller="hero-rename hero-dismiss hero-sell hero-promote"
     data-hero-rename-hero-id-value="{{ hero.id }}"
     data-hero-rename-error-empty-value="{{ 'js_flash.heroes.name_empty'|trans }}"
     data-hero-rename-error-rename-value="{{ 'js_flash.heroes.failed_rename'|trans }}"
     data-hero-dismiss-hero-id-value="{{ hero.id }}"
     data-hero-dismiss-title-dismiss-value="{{ 'heroes.dismiss_title'|trans }}"
     data-hero-dismiss-confirm-dismiss-value="{{ 'heroes.dismiss_confirm'|trans }}"
     data-hero-dismiss-error-dismiss-value="{{ 'js_flash.heroes.failed_dismiss'|trans }}"
     data-hero-dismiss-success-dismiss-value="{{ 'js_flash.heroes.success_dismiss'|trans }}"
     data-hero-dismiss-text-loading-value="{{ 'js_flash.common.text_loading'|trans }}"
     data-hero-sell-hero-id-value="{{ hero.id }}"
     data-hero-sell-title-sell-value="{{ 'heroes.sell_title'|trans }}"
     data-hero-sell-confirm-sell-value="{{ 'heroes.sell_confirm'|trans }}"
     data-hero-sell-error-sell-value="{{ 'js_flash.heroes.failed_sell'|trans }}"
     data-hero-sell-success-sell-value="{{ 'js_flash.heroes.success_sell'|trans }}"
     data-hero-sell-price-label-buy-now-value="{{ 'marketplace.price_gold'|trans }}"
     data-hero-sell-price-label-auction-value="{{ 'marketplace.label_min_bid'|trans }}"
     data-hero-sell-text-loading-value="{{ 'js_flash.common.text_loading'|trans }}"
     data-hero-sell-suggested-price-value="{{ hero_market_price(hero) }}"
     data-hero-promote-hero-id-value="{{ hero.id }}"
     data-hero-promote-title-promote-value="{{ 'training.promote_title'|trans }}"
     data-hero-promote-confirm-promote-value="{{ 'training.promote_confirm'|trans }}"
     data-hero-promote-error-promote-value="{{ 'training.error_promote'|trans }}"
     data-hero-promote-success-promote-value="{{ 'training.success_promote'|trans }}"
     data-hero-promote-text-loading-value="{{ 'js_flash.common.text_loading'|trans }}"
>
    {% include 'components/hero/header_card.html.twig' with { hero: hero, show_manage: true, trainers: trainers, trainer_limit: trainer_limit } %}

    <div class="tab-nav-bar hero-detail-tabs" data-controller="tab">
        {% for t in hero_tabs %}
            <button type="button" data-tab-target="btn" data-action="click->tab#switch" data-tab="hero-tab-{{ t.id }}"
                    class="tab-btn {{ tab == t.id ? 'tab-btn--active' : '' }}">
                {{ t.emoji }} {{ t.label|trans }}
            </button>
        {% endfor %}
    </div>

    <div id="hero-tab-overview" class="tab-content {% if tab != 'overview' %}hidden{% endif %}">
        <div class="layout-stack layout-stack--lg">
            
            <div class="hero-detail-grid">
                {% include 'components/hero/attributes_panel.html.twig' with { hero: hero, equipped: equipped } %}
                {% include 'components/hero/derived_combat_stats_panel.html.twig' with { hero: hero } %}
            </div>

            <div class="layout-stack" data-controller="training"
                     data-training-success-configure-value="{{ 'training.success_configure'|trans }}"
                     data-training-success-assign-value="{{ 'training.success_assign'|trans }}"
                     data-training-success-unassign-value="{{ 'training.success_unassign'|trans }}"
                     data-training-error-fetch-value="{{ 'js_flash.training.error_fetch'|trans }}"
                     data-training-is-locked-value="{{ is_training_locked ? 'true' : 'false' }}"
                     data-training-text-saving-value="{{ 'js_flash.training.text_saving'|trans }}"
                     data-training-text-removing-value="{{ 'js_flash.training.text_removing'|trans }}"
                     data-training-error-save-focus-value="{{ 'js_flash.training.error_save_focus'|trans }}"
                     data-training-error-assign-hero-value="{{ 'js_flash.training.error_assign_hero'|trans }}"
                     data-training-error-remove-hero-value="{{ 'js_flash.training.error_remove_hero'|trans }}"
                     data-training-title-dismiss-value="{{ 'training.dismiss_btn'|trans }}"
                     data-training-confirm-dismiss-value="{{ 'training.dismiss_confirm'|trans }}"
                     data-training-error-dismiss-value="{{ 'js_flash.training.failed_dismiss'|trans }}"
                     data-training-success-dismiss-value="{{ 'js_flash.training.success_dismiss'|trans }}">
                    {% include 'components/ui/alert_box.html.twig' with { target: 'training', message_target: 'alertMessage', close_action: 'training#closeAlert' } %}

                    {% if hero.trainer %}
                        {% set is_capped = false %}
                        {% if hero.trainer.trainingType and hero.trainer.trainingType.value == 'attribute' and hero.trainer.targetAttribute %}
                            {% set attrKey = hero.trainer.targetAttribute %}
                            {% set heroVal = attribute(hero, attrKey == 'int' ? 'intel' : attrKey) %}
                            {% set trainerVal = attribute(hero.trainer, attrKey == 'int' ? 'intel' : attrKey) %}
                            {% if heroVal >= trainerVal %}
                                {% set is_capped = true %}
                            {% endif %}
                        {% elseif hero.trainer.trainingType and hero.trainer.trainingType.value == 'magic' %}
                            {% if hero.magicCapacity >= 5 %}
                                {% set is_capped = true %}
                            {% endif %}
                        {% endif %}

                        <div class="game-panel training-hero-dashboard">
                            <div class="training-hero-dashboard__header">
                                <h3 class="game-panel__title">{{ 'heroes.current_trainer'|trans }}</h3>
                                {% if is_training_locked %}
                                    <span class="status-chip status-chip--danger">🔒 {{ 'training.locked'|trans }}</span>
                                {% endif %}
                            </div>
                            
                            {% if is_capped %}
                                <div class="alert alert-warning" role="alert" style="margin-bottom: 1.25rem;">
                                    <span class="emoji-icon" aria-hidden="true">⚠️</span>
                                    <span>{{ 'training.capped_hero_warning'|trans }}</span>
                                </div>
                            {% endif %}

                            <div class="training-hero-dashboard__grid">
                                {# Trainer info #}
                                <div class="training-hero-dashboard__trainer-info">
                                    <div class="trainer-identity">
                                        <span class="trainer-avatar" aria-hidden="true">👨‍🏫</span>
                                        <div>
                                            <span class="trainer-name">{{ hero.trainer.name }}</span>
                                            <span class="trainer-meta">
                                                {{ race_icon(hero.trainer.race) }} {{ ('heroes.race_' ~ hero.trainer.race.value)|trans }} &bull; 
                                                {{ 'heroes.age'|trans }}: {{ hero.trainer.age }} {{ 'heroes.years'|trans }} 
                                                ({{ ('heroes.age_phase.' ~ hero_age_phase(hero.trainer)|lower)|trans }} {{ hero_age_phase_icon(hero.trainer) }})
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                {# Focus & Progress #}
                                <div class="training-hero-dashboard__progress-panel">
                                    <h4 class="training-section-title">{{ 'training.training_focus'|trans }}</h4>
                                    <div class="focus-details">
                                        <div class="focus-details__type">
                                            <span class="focus-type-label">{{ 'training.type'|trans }}:</span>
                                            <span class="focus-type-value">
                                                {% if hero.trainer.trainingType %}
                                                    {{ ('training.type_' ~ hero.trainer.trainingType.value)|trans }}
                                                    {% if hero.trainer.trainingType.value == 'attribute' and hero.trainer.targetAttribute %}
                                                        — {{ ('training.attr.' ~ hero.trainer.targetAttribute)|trans }}
                                                    {% endif %}
                                                {% else %}
                                                    <span class="copy-muted">{{ 'training.idle'|trans }}</span>
                                                {% endif %}
                                            </span>
                                        </div>

                                        {% if hero.trainer.trainingType and hero.trainer.trainingType.value == 'attribute' and hero.trainer.targetAttribute %}
                                            {% set attrKey = hero.trainer.targetAttribute %}
                                            {% set heroVal = attribute(hero, attrKey == 'int' ? 'intel' : attrKey) %}
                                            {% set trainerVal = attribute(hero.trainer, attrKey == 'int' ? 'intel' : attrKey) %}
                                            {% set progressPct = min(100, (heroVal / trainerVal) * 100) %}
                                            <div class="focus-details__progress-bar">
                                                <div class="progress-bar-header">
                                                    <span class="progress-bar-label">{{ 'training.progress_cap'|trans }}:</span>
                                                    <span class="progress-bar-values">
                                                        <span class="training-progress-value{% if heroVal >= trainerVal %} training-progress-value--capped{% endif %}">
                                                            {{ heroVal }} / {{ trainerVal }}
                                                        </span>
                                                        {% if heroVal >= trainerVal %}
                                                            <span class="training-progress-cap-label">({{ 'training.capped'|trans }})</span>
                                                        {% endif %}
                                                    </span>
                                                </div>
                                                {% include 'components/ui/progress_bar.html.twig' with {
                                                    percentage: progressPct,
                                                    container_class: 'ui-progress ui-progress--compact',
                                                    progress_class: heroVal >= trainerVal ? 'ui-progress__fill ui-progress__fill--danger' : 'ui-progress__fill ui-progress__fill--accent'
                                                } %}
                                            </div>
                                        {% elseif hero.trainer.trainingType and hero.trainer.trainingType.value == 'magic' %}
                                            {% set progressPct = min(100, (hero.magicCapacity / 5) * 100) %}
                                            <div class="focus-details__progress-bar">
                                                <div class="progress-bar-header">
                                                    <span class="progress-bar-label">{{ 'training.progress_cap'|trans }}:</span>
                                                    <span class="progress-bar-values">
                                                        <span class="training-progress-value{% if hero.magicCapacity >= 5 %} training-progress-value--capped{% endif %}">
                                                            {{ hero.magicCapacity }} / 5
                                                        </span>
                                                        {% if hero.magicCapacity >= 5 %}
                                                            <span class="training-progress-cap-label">({{ 'training.capped'|trans }})</span>
                                                        {% endif %}
                                                    </span>
                                                </div>
                                                {% include 'components/ui/progress_bar.html.twig' with {
                                                    percentage: progressPct,
                                                    container_class: 'ui-progress ui-progress--compact',
                                                    progress_class: hero.magicCapacity >= 5 ? 'ui-progress__fill ui-progress__fill--danger' : 'ui-progress__fill ui-progress__fill--accent'
                                                } %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Forecast #}
                                <div class="training-hero-dashboard__forecast">
                                    <h4 class="training-section-title">{{ 'training.forecast'|trans }} ({{ next_lock_formatted }})</h4>
                                    <div class="forecast-indicators">
                                        <div class="forecast-row">
                                            <span class="forecast-label">{{ 'heroes.fatigue'|trans }}:</span>
                                            <span class="forecast-values">
                                                {{ hero.fatigue }}% &rarr;
                                                {% if hero.trainer.trainingType %}
                                                    {% if hero.trainer.trainingType.value == 'form' %}
                                                        <span class="copy-status-success">{{ max(0, hero.fatigue - 20) }}%</span>
                                                    {% else %}
                                                        <span class="copy-status-error">{{ min(100, hero.fatigue + 20) }}%</span>
                                                    {% endif %}
                                                {% else %}
                                                    <span>{{ hero.fatigue }}%</span>
                                                {% endif %}
                                            </span>
                                        </div>
                                        <div class="forecast-row">
                                            <span class="forecast-label">{{ 'heroes.combat_form'|trans }}:</span>
                                            <span class="forecast-values">
                                                {{ hero.form }}% &rarr;
                                                {% if hero.trainer.trainingType and hero.trainer.trainingType.value == 'form' %}
                                                    <span class="copy-status-success copy-strong">{{ min(100, hero.form + 20) }}%</span>
                                                {% else %}
                                                    <span>{{ hero.form }}%</span>
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="training-hero-dashboard__footer">
                                <button type="button" data-action="click->training#unassignTrainee"
                                        data-trainer-id="{{ hero.trainer.id }}" data-hero-id="{{ hero.id }}"
                                        class="btn btn-outline btn--sm" {% if is_training_locked %}disabled{% endif %}>
                                    {{ 'training.unassign_hero'|trans }}
                                </button>
                            </div>
                        </div>
                    {% else %}
                        <div class="game-panel">
                            <div class="layout-stack layout-stack--xs">
                                <h3 class="game-panel__title" style="margin: 0;">{{ 'training.assign_trainer_title'|trans }}</h3>
                                <p class="copy-muted copy-xs" style="margin: 0;">{{ 'training.select_trainer_desc'|trans }}</p>
                            </div>
                            
                            <div class="training-trainer-grid">
                                {% for trainer in trainers %}
                                    {% set maxSlots = training_service.getTrainerSlotsLimit(trainer) %}
                                    {% set occupiedSlots = trainer.heroes|length %}
                                    {% set isFull = occupiedSlots >= maxSlots %}
                                    {% set isTrainerAvailable = trainer.status.value == 'available' %}
                                    
                                    <div class="trainer-card">
                                        <div class="trainer-card__main">
                                            <div class="trainer-card__header">
                                                <div class="trainer-card__identity">
                                                    <span class="trainer-card__emoji" aria-hidden="true">👨‍🏫</span>
                                                    <div>
                                                        <h3 class="trainer-card__name">{{ trainer.name }}</h3>
                                                        <span class="trainer-card__meta">
                                                            {{ race_icon(trainer.race) }} {{ ('heroes.race_' ~ trainer.race.value)|trans }} &bull; 
                                                            {{ 'heroes.age'|trans }}: {{ trainer.age }} {{ 'heroes.years'|trans }}
                                                        </span>
                                                    </div>
                                                </div>
                                                <span class="trainer-slot-badge">
                                                    {{ 'training.trainer_slots'|trans({'%occupied%': occupiedSlots, '%limit%': maxSlots}) }}
                                                </span>
                                            </div>

                                            <div class="trainer-card__section">
                                                <h4 class="trainer-card__section-title">{{ 'training.training_focus'|trans }}</h4>
                                                <p class="copy-primary trainer-card__focus-value">
                                                    {% if trainer.trainingType %}
                                                        {{ ('training.type_' ~ trainer.trainingType.value)|trans }}
                                                        {% if trainer.trainingType.value == 'attribute' and trainer.targetAttribute %}
                                                            — {{ ('training.attr.' ~ trainer.targetAttribute)|trans }} ({{ attribute(trainer, trainer.targetAttribute == 'int' ? 'intel' : trainer.targetAttribute) }})
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="copy-muted">{{ 'training.idle'|trans }}</span>
                                                    {% endif %}
                                                </p>
                                            </div>
                                        </div>

                                        <div class="trainer-card__assign">
                                            {% if is_training_locked %}
                                                <button type="button" class="btn btn-outline btn--sm btn--block" disabled>
                                                    🔒 {{ 'training.locked'|trans }}
                                                </button>
                                            {% elseif not isTrainerAvailable %}
                                                <button type="button" class="btn btn-outline btn--sm btn--block" disabled>
                                                    {{ 'training.dismiss_selling_desc'|trans }}
                                                </button>
                                            {% elseif isFull %}
                                                <button type="button" class="btn btn-outline btn--sm btn--block" disabled>
                                                    {{ 'training.capped'|trans }}
                                                </button>
                                            {% else %}
                                                <button type="button" 
                                                        data-action="click->training#assignTraineeDirect" 
                                                        data-trainer-id="{{ trainer.id }}" 
                                                        data-hero-id="{{ hero.id }}"
                                                        class="btn btn-primary btn--sm btn--block">
                                                    💪 {{ 'training.assign_hero'|trans }}
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="training-empty-state">
                                        <span class="training-empty-state__icon">📭</span>
                                        <h3 class="game-panel__title">{{ 'training.no_trainers_title'|trans }}</h3>
                                        <p class="training-empty-state__desc">{{ 'training.no_trainers_desc'|trans }}</p>
                                    </div>
                                {% endfor %}
                            </div>
                            
                            <a href="{{ path('app_training') }}" class="link link--block training-manage-link">
                                {{ 'heroes.manage_all_trainers'|trans }} →
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    <div id="hero-tab-equipment" class="tab-content {% if tab != 'equipment' %}hidden{% endif %}">
        <div class="layout-stack layout-stack--lg" data-controller="equipment"
             data-equipment-text-equipping-value="{{ 'js_flash.inventory.equipping'|trans }}"
             data-equipment-error-equip-value="{{ 'js_flash.inventory.failed_equip'|trans }}"
             data-equipment-success-equip-value="{{ 'js_flash.inventory.success_equip'|trans }}"
             data-equipment-text-unequipping-value="{{ 'js_flash.inventory.unequipping'|trans }}"
             data-equipment-error-unequip-value="{{ 'js_flash.inventory.failed_unequip'|trans }}"
             data-equipment-success-unequip-value="{{ 'js_flash.inventory.success_unequip'|trans }}"
             data-equipment-confirm-dismantle-value="{{ 'js_flash.inventory.confirm_dismantle'|trans }}"
             data-equipment-title-dismantle-value="{{ 'inventory.dismantle'|trans }}"
             data-equipment-text-dismantling-value="{{ 'js_flash.inventory.dismantling'|trans }}"
             data-equipment-error-dismantle-value="{{ 'js_flash.inventory.failed_dismantle'|trans }}"
             data-equipment-success-dismantle-value="{{ 'js_flash.inventory.success_dismantle'|trans }}"
             data-equipment-text-repairing-value="{{ 'js_flash.inventory.repairing'|trans }}"
             data-equipment-error-repair-value="{{ 'js_flash.inventory.failed_repair'|trans }}"
             data-equipment-success-repair-value="{{ 'js_flash.inventory.success_repair'|trans }}">
            {% include 'components/ui/alert_box.html.twig' with { target: 'equipment', message_target: 'alertMessage', close_action: 'equipment#hideAlert' } %}
            <div class="equipment-layout">
                <div class="equipment-layout__paperdoll">
                    {% include 'components/item/equip_manager.html.twig' with {
                        selected_hero_id: hero.id,
                        selected_hero: hero,
                        heroes: heroes,
                        equipped: equipped,
                        hide_hero_select: true
                    } %}
                </div>
                <div class="equipment-layout__rucksack">
                    {% include 'components/item/rucksack_items.html.twig' with { items: items, selected_hero: hero } %}
                </div>
            </div>
        </div>
    </div>

    <div id="hero-tab-spells" class="tab-content {% if tab != 'spells' %}hidden{% endif %}">
        <div class="spellbook-page" data-controller="spellbook"
             data-spellbook-text-learning-value="{{ 'js_flash.spells.learning'|trans }}"
             data-spellbook-error-learn-value="{{ 'js_flash.spells.failed_learn'|trans }}"
             data-spellbook-success-learn-value="{{ 'js_flash.spells.success_learn'|trans }}"
             data-spellbook-error-equip-value="{{ 'js_flash.spells.failed_equip'|trans }}"
             data-spellbook-success-equip-value="{{ 'js_flash.spells.success_equip'|trans }}"
             data-spellbook-error-unequip-value="{{ 'js_flash.spells.failed_unequip'|trans }}"
             data-spellbook-text-equipping-value="{{ 'js_flash.inventory.equipping'|trans }}"
             data-spellbook-success-unequip-value="{{ 'js_flash.spells.success_unequip'|trans }}">
            {% include 'components/ui/alert_box.html.twig' with { target: 'spellbook', message_target: 'alertMessage', close_action: 'spellbook#hideAlert' } %}
            <div class="layout-stack layout-stack--lg">
                <div class="dashboard-grid-2">
                    {% include 'components/spell/trainee_manager.html.twig' with {
                        selected_hero_id: hero.id,
                        selected_hero: hero,
                        heroes: heroes,
                        equipped: equipped_spells,
                        masteries: masteries,
                        hide_hero_select: true
                    } %}
                    {% include 'components/hero/school_mastery.html.twig' with { hero: hero } %}
                </div>
                <div class="layout-stack layout-stack--md">
                    <div class="tab-nav" data-controller="tab">
                        <button type="button" data-tab-target="btn" data-action="click->tab#switch" data-tab="learned-spells-tab" class="tab-btn tab-btn--active">
                            {{ 'spells.tab_learned'|trans }}
                        </button>
                        <button type="button" data-tab-target="btn" data-action="click->tab#switch" data-tab="academy-store-tab" class="tab-btn">
                            {{ 'spells.tab_store'|trans }}
                        </button>
                    </div>
                    {% include 'components/spell/learned_spells.html.twig' with { selected_hero: hero, equipped: equipped_spells } %}
                    {% include 'components/spell/academy_store.html.twig' with { spells: spells, known_spell_ids: known_spell_ids, selected_hero: hero, masteries: masteries, team: team } %}
                </div>
            </div>
        </div>
    </div>



    <div id="hero-tab-history" class="tab-content {% if tab != 'history' %}hidden{% endif %}">
        <div class="layout-stack layout-stack--lg">
            {% include 'components/hero/combat_stats.html.twig' with { hero: hero, trainingHistory: trainingHistory } %}
            {% include 'components/hero/weapon_mastery.html.twig' with { hero: hero, equipped: equipped } %}
            {% include 'components/hero/recent_activity.html.twig' with { hero: hero, trainingHistory: trainingHistory, heroHistory: heroHistory } %}
        </div>
    </div>

    {# Sell Hero Modal #}
    {% if hero.isCombatant and hero.status.value == 'available' %}
        <div data-controller="modal" data-modal-event-name-value="modal:open-sell-hero" id="sell-hero-modal">
            <div data-modal-target="dialog" class="hidden modal-overlay" data-action="click->modal#closeBackdrop">
                <div class="modal-box modal-form" role="dialog" aria-modal="true" aria-labelledby="sell-modal-title">
                    <button type="button" data-action="click->modal#close" class="modal-close" aria-label="{{ 'modal.close'|trans }}">
                        <span aria-hidden="true" class="modal-close__icon">✕</span>
                        <span class="sr-only">{{ 'modal.close'|trans }}</span>
                    </button>
                    <h2 id="sell-modal-title" class="modal-form__title">🪙 {{ 'heroes.sell_title'|trans }}</h2>
                    <div class="modal-form__body">
                        {% include 'components/hero/sell_panel.html.twig' with { hero: hero, team: team } %}
                    </div>
                </div>
            </div>
        </div>

        {# Dismiss Hero Modal #}
        <div data-controller="modal" data-modal-event-name-value="modal:open-dismiss-hero" id="dismiss-hero-modal">
            <div data-modal-target="dialog" class="hidden modal-overlay" data-action="click->modal#closeBackdrop">
                <div class="modal-box modal-form" role="dialog" aria-modal="true" aria-labelledby="dismiss-modal-title">
                    <button type="button" data-action="click->modal#close" class="modal-close" aria-label="{{ 'modal.close'|trans }}">
                        <span aria-hidden="true" class="modal-close__icon">✕</span>
                        <span class="sr-only">{{ 'modal.close'|trans }}</span>
                    </button>
                    <h2 id="dismiss-modal-title" class="modal-form__title">❌ {{ 'heroes.dismiss_title'|trans }}</h2>
                    <div class="modal-form__body">
                        {% include 'components/hero/dismiss_panel.html.twig' with { hero: hero, team: team } %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
