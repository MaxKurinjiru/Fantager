{# templates/components/item/equip_manager.html.twig #}
{# hide_hero_select: when true, replaces the hero dropdown with a static label (used on hero detail page) #}
{% set hide_hero_select = hide_hero_select ?? false %}
<div class="game-panel">
    <div>
        <h2 class="hero-panel__title">{{ 'inventory.equip_manager'|trans }}</h2>
        {% if hide_hero_select %}
            {# On the hero detail page: show hero name, pass id via hidden input #}
            <input type="hidden"
                   id="equip-hero-select"
                   data-equipment-target="heroSelect"
                   value="{{ selected_hero_id }}">
        {% else %}
            <label for="equip-hero-select" class="form-label">{{ 'inventory.select_hero_opt'|trans }}</label>
            <select id="equip-hero-select" data-equipment-target="heroSelect" data-action="change->equipment#loadHeroEquipment"
                    class="form-input form-input--medium">
                <option value="">{{ 'inventory.select_hero_opt'|trans }}</option>
                {% for h in heroes %}
                    <option value="{{ h.id }}" {% if selected_hero_id == h.id %}selected{% endif %}>
                        {{ h.name }} ({{ 'heroes.level'|trans }} {{ h.level }} &bull; {{ ('heroes.race_' ~ h.race.value)|trans }})
                    </option>
                {% endfor %}
            </select>
        {% endif %}
    </div>


    {# Paperdoll Grid #}
    {% if selected_hero %}
        <div class="layout-stack layout-stack--md">
            <span class="section-label--xs section-label--xs--center">{{ 'inventory.paperdoll'|trans }}</span>
            
            <div class="paperdoll-grid">
                {% set slots = [
                    {key: 'head', emoji: '🪖'},
                    {key: 'amulet', emoji: '📿'},
                    {key: 'body', emoji: '🛡️'},
                    {key: 'hands', emoji: '🧤'},
                    {key: 'main_hand', emoji: '⚔️'},
                    {key: 'off_hand', emoji: '🛡️'},
                    {key: 'ring', emoji: '💍'},
                    {key: 'ring_2', emoji: '💍'},
                    {key: 'feet', emoji: '🥾'}
                ] %}
                {% set main_item = equipped['main_hand'] ?? null %}
                {% set off_blocked = main_item is not null and main_item.subType is not null and main_item.subType.occupiesBothHands %}

                {% for slot in slots %}
                    {% set item = equipped[slot.key] ?? null %}
                    {% set blocked = slot.key == 'off_hand' and off_blocked %}
                    {% set race_hint = item_slot_race_hint(selected_hero, slot.key) %}
                    {% if item %}
                        {% set display_name = item_display_name(item) %}
                        <div class="paperdoll-slot paperdoll-slot--{{ slot.key }} paperdoll-slot--equipped paperdoll-slot--rarity-{{ item.rarity.value }}">
                            {# Unequip Button #}
                            <button type="button" data-action="click->equipment#unequip" data-item-id="{{ item.id }}"
                                    class="btn btn-danger btn--sm paperdoll-slot__unequip"
                                    aria-label="{{ 'inventory.unequip'|trans }}">
                                ✕
                            </button>

                            <span class="paperdoll-slot__label">{{ ('inventory.slot_' ~ slot.key)|trans }}</span>
                            <span class="paperdoll-slot__icon">{{ slot.emoji }}</span>
                            <span class="paperdoll-slot__item-name" title="{{ display_name }}">{{ display_name }}</span>
                            <span class="paperdoll-slot__equipped-label">{{ 'inventory.equipped'|trans }}</span>
                        </div>
                    {% else %}
                        <div class="paperdoll-slot paperdoll-slot--{{ slot.key }} paperdoll-slot--empty{% if blocked or race_hint %} paperdoll-slot--blocked{% endif %}{% if race_hint %} paperdoll-slot--race-blocked{% endif %}">
                            <span class="paperdoll-slot__label">{{ ('inventory.slot_' ~ slot.key)|trans }}</span>
                            <span class="paperdoll-slot__icon">{{ slot.emoji }}</span>
                            {% if race_hint %}
                                <span class="paperdoll-slot__empty-hint" title="{{ race_hint }}">{{ 'inventory.slot_race_restricted'|trans }}</span>
                            {% else %}
                                <span class="paperdoll-slot__empty-hint">{{ (blocked ? 'inventory.slot_two_hand_held' : 'inventory.empty_slot')|trans }}</span>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="empty-placeholder">
            <span class="empty-placeholder__icon">🧑</span>
            <h4 class="spell-empty-state__title">{{ 'inventory.select_hero_manage'|trans }}</h4>
            <p class="spell-empty-state__desc">{{ 'inventory.select_hero_manage_desc'|trans }}</p>
        </div>
    {% endif %}
</div>
