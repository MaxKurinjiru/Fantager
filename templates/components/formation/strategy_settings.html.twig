{# templates/components/formation/strategy_settings.html.twig #}
{% set match_edit_source = match_edit_source|default(null) %}
{% set defaults = tactics_defaults|default({
    movement_front: 'advance_to_melee',
    movement_back: 'seek_cover_ranged',
    target_order: [],
    fallback: 'approach'
}) %}
{% set default_positions = ['front_1', 'front_2', 'front_3', 'back_1', 'back_2', 'back_3'] %}
<div class="feature-panel formation-strategy-panel">
    <div>
        <h2 class="feature-panel__title">{{ 'formation.match_strategy'|trans }}</h2>
        <p class="feature-panel__desc">{{ 'formation.match_strategy_desc'|trans }}</p>
    </div>

    <div class="formation-strategy-panel__body">
        <div class="formation-strategy-panel__meta">
            <div class="formation-strategy-panel__name">
                <label for="formation-name" class="form-label">{{ 'formation.formation_name'|trans }}</label>
                <input type="text" id="formation-name" data-formation-target="nameInput"
                       value="{{ match_edit_source ? match_edit_source.name : (selected_formation ? selected_formation.name : 'formation.tactics_slot'|trans) }}"
                       placeholder="{{ 'formation.name_placeholder'|trans }}"
                       class="form-input form-input--emphasis">
            </div>

            <div class="form-check formation-strategy-panel__default">
                <input type="checkbox" id="set-default" data-formation-target="defaultCheckbox"
                       class="form-check__input"
                       {% if selected_formation and selected_formation.isDefault %}checked{% endif %}
                       {% if match_edit_source %}disabled{% endif %}>
                <label for="set-default">{{ 'formation.set_default'|trans }}</label>
            </div>
        </div>

        <div class="formation-strategy-panel__tactics">
            <span class="section-label--xs">{{ 'formation.prematch_approach'|trans }}</span>
            <div class="formation-strategy-panel__tactics-grid">
                {% set approaches = [
                    {key: 'aggressive', label: 'formation.tactics_aggressive'|trans, desc: 'formation.tactics_aggressive_desc'|trans},
                    {key: 'balanced', label: 'formation.tactics_balanced'|trans, desc: 'formation.tactics_balanced_desc'|trans},
                    {key: 'defensive', label: 'formation.tactics_defensive'|trans, desc: 'formation.tactics_defensive_desc'|trans}
                ] %}

                {% for app in approaches %}
                    {% set approach_selected = (match_edit_source and match_edit_source.approach == app.key)
                        or (selected_formation and selected_formation.approach.value == app.key)
                        or (not match_edit_source and not selected_formation and app.key == 'balanced') %}
                    <label class="tactic-option{% if approach_selected %} tactic-option--selected{% endif %}">
                        <input type="radio" data-formation-target="approachRadio" name="approach" value="{{ app.key }}"
                               data-action="change->formation#changeApproach"
                               class="tactic-option__radio form-control-accent"
                               {% if approach_selected %}checked{% endif %}>
                        <div class="tactic-option__body">
                            <span class="tactic-option__title">{{ app.label }}</span>
                            <p class="tactic-option__desc">{{ app.desc }}</p>
                        </div>
                    </label>
                {% endfor %}
            </div>
        </div>

        <div class="formation-strategy-panel__spatial">
            <span class="section-label--xs">{{ 'formation.movement_strategy'|trans }}</span>
            <p class="copy-muted">{{ 'formation.movement_strategy_hint'|trans }}</p>
            <div class="formation-strategy-panel__row-goals">
                <div class="form-field-group">
                    <label for="movement-front" class="form-label">{{ 'formation.movement_front_row'|trans }}</label>
                    <select id="movement-front"
                            data-formation-target="movementFrontSelect"
                            data-action="change->formation#changeDefaultMovement"
                            class="form-select formation-strategy-panel__movement-select">
                        {% include 'components/formation/_movement_options.html.twig' with { selected: defaults.movement_front } %}
                    </select>
                </div>
                <div class="form-field-group">
                    <label for="movement-back" class="form-label">{{ 'formation.movement_back_row'|trans }}</label>
                    <select id="movement-back"
                            data-formation-target="movementBackSelect"
                            data-action="change->formation#changeDefaultMovement"
                            class="form-select formation-strategy-panel__movement-select">
                        {% include 'components/formation/_movement_options.html.twig' with { selected: defaults.movement_back } %}
                    </select>
                </div>
            </div>
            <button type="button"
                    class="btn btn-outline btn--sm"
                    data-action="click->formation#applyMovementToAll">
                {{ 'formation.movement_apply_all'|trans }}
            </button>
        </div>

        <div class="formation-strategy-panel__defaults">
            <span class="section-label--xs">{{ 'formation.default_targeting'|trans }}</span>
            <p class="copy-muted">{{ 'formation.default_targeting_hint'|trans }}</p>
            <ol data-formation-target="defaultTargetOrderList" class="formation-tactics-list"></ol>
            <div class="layout-cluster layout-cluster--sm">
                <label for="formation-default-add-target" class="sr-only">{{ 'formation.tactics_add_target'|trans }}</label>
                <select id="formation-default-add-target" data-formation-target="defaultAddTargetSelect" class="form-select">
                    <option value="">{{ 'formation.tactics_add_target'|trans }}</option>
                    {% for pos in default_positions %}
                        <option value="{{ pos }}">{{ ('formation.slots.' ~ pos)|trans }}</option>
                    {% endfor %}
                </select>
                <button type="button" class="btn btn-outline btn--sm" data-action="click->formation#addDefaultTarget">
                    {{ 'formation.tactics_add'|trans }}
                </button>
            </div>
            <div class="form-field-group">
                <label for="formation-default-fallback" class="form-label">{{ 'formation.tactics_fallback'|trans }}</label>
                <select id="formation-default-fallback"
                        data-formation-target="defaultFallbackSelect"
                        data-action="change->formation#changeDefaultFallback"
                        class="form-select">
                    <option value="approach"{% if defaults.fallback == 'approach' %} selected{% endif %}>{{ 'formation.tactics_fallback_approach'|trans }}</option>
                    <option value="lowest_hp"{% if defaults.fallback == 'lowest_hp' %} selected{% endif %}>{{ 'formation.tactics_fallback_lowest_hp'|trans }}</option>
                    <option value="highest_threat"{% if defaults.fallback == 'highest_threat' %} selected{% endif %}>{{ 'formation.tactics_fallback_highest_threat'|trans }}</option>
                </select>
            </div>
            <button type="button"
                    class="btn btn-outline btn--sm"
                    data-action="click->formation#applyTargetingToAll">
                {{ 'formation.targeting_apply_all'|trans }}
            </button>
        </div>
    </div>

    <div class="formation-strategy__footer">
        <button type="button"
                data-action="click->formation#save"
                class="btn btn-primary formation-strategy__save-btn">
            {{ match_edit_source ? 'formation.save_match_lineup'|trans : 'formation.save_lineup'|trans }}
        </button>
    </div>
</div>

<template data-formation-target="defaultTargetOrderRowTemplate">
    <li class="formation-tactics-row" data-slot-value="">
        <span data-slot-label class="formation-tactics-row__label"></span>
        <div class="layout-cluster layout-cluster--sm">
            <button type="button" class="btn btn-ghost btn--sm" data-action="click->formation#moveDefaultTargetUp" aria-label="{{ 'formation.tactics_move_up'|trans }}">↑</button>
            <button type="button" class="btn btn-ghost btn--sm" data-action="click->formation#moveDefaultTargetDown" aria-label="{{ 'formation.tactics_move_down'|trans }}">↓</button>
            <button type="button" class="btn btn-ghost btn--sm" data-action="click->formation#removeDefaultTarget" aria-label="{{ 'formation.tactics_remove'|trans }}">✕</button>
        </div>
    </li>
</template>
