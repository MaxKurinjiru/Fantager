{# templates/components/hero/school_mastery.html.twig #}
<div class="hero-panel" data-controller="mastery-toggle">
    <div>
        <h2 class="hero-panel__title">{{ 'heroes.school_mastery'|trans }}</h2>
    </div>

    {% set schools = ['fire', 'water', 'air', 'earth', 'light', 'dark'] %}
    {% set school_list = [] %}
    {% for school in schools %}
        {% set mastery_tier = 1 %}
        {% set school_xp = 0 %}
        {% for sm in hero.schoolMasteries %}
            {% if sm.school.value == school %}
                {% set mastery_tier = sm.masteryTier %}
                {% set school_xp = sm.xp %}
            {% endif %}
        {% endfor %}
        {% set school_list = school_list|merge([{
            school: school,
            mastery_tier: mastery_tier,
            school_xp: school_xp
        }]) %}
    {% endfor %}

    {# Build list of schools of currently equipped spells #}
    {% set equipped_schools = [] %}
    {% for hs in hero.heroSpells|default([]) %}
        {% if hs.isEquipped and hs.spell.school.value not in equipped_schools %}
            {% set equipped_schools = equipped_schools|merge([hs.spell.school.value]) %}
        {% endif %}
    {% endfor %}

    {% set active_count = 0 %}
    {% for item in school_list %}
        {% if item.school_xp > 0 or item.mastery_tier > 1 or item.school in equipped_schools %}
            {% set active_count = active_count + 1 %}
        {% endif %}
    {% endfor %}

    {# Sort descending by school_xp #}
    {% set sorted_schools = school_list|sort((a, b) => b.school_xp <=> a.school_xp) %}

    <div class="hero-mastery-list">
        {% for item in sorted_schools %}
            {% set school = item.school %}
            {% set mastery_tier = item.mastery_tier %}
            {% set school_xp = item.school_xp %}
            
            {% set next_req = 100 %}
            {% set relative_xp = school_xp %}
            {% set relative_req = 100 %}

            {% if mastery_tier == 1 %}
                {% set next_req = 100 %}
                {% set relative_xp = school_xp %}
                {% set relative_req = 100 %}
            {% elseif mastery_tier == 2 %}
                {% set next_req = 300 %}
                {% set relative_xp = school_xp - 100 %}
                {% set relative_req = 200 %}
            {% elseif mastery_tier == 3 %}
                {% set next_req = 600 %}
                {% set relative_xp = school_xp - 300 %}
                {% set relative_req = 300 %}
            {% elseif mastery_tier == 4 %}
                {% set next_req = 1000 %}
                {% set relative_xp = school_xp - 600 %}
                {% set relative_req = 400 %}
            {% else %}
                {% set next_req = 1000 %}
                {% set relative_xp = 1 %}
                {% set relative_req = 1 %}
            {% endif %}

            {% set progress_pct = (relative_xp / relative_req * 100)|round(0, 'floor') %}
            {% if mastery_tier == 5 %}
                {% set progress_pct = 100 %}
            {% endif %}

            {% set is_equipped = school in equipped_schools %}
            {% set is_inactive = not (school_xp > 0 or mastery_tier > 1 or is_equipped) %}

            {% set school_icon = '🔮' %}
            {% if school == 'fire' %}{% set school_icon = '🔥' %}
            {% elseif school == 'water' %}{% set school_icon = '💧' %}
            {% elseif school == 'air' %}{% set school_icon = '💨' %}
            {% elseif school == 'earth' %}{% set school_icon = '🪨' %}
            {% elseif school == 'light' %}{% set school_icon = '☀️' %}
            {% elseif school == 'dark' %}{% set school_icon = '🌙' %}{% endif %}

            <div class="hero-mastery-row {% if is_equipped %}hero-mastery-row--equipped{% endif %} {% if is_inactive %}hidden{% endif %}"
                 {% if is_inactive %}data-mastery-toggle-target="item"{% endif %}>
                <div class="hero-mastery-row__info">
                    <span class="hero-mastery-row__icon">{{ school_icon }}</span>
                    <span class="hero-mastery-row__name" title="{{ ('school.' ~ school)|trans }}">{{ ('school.' ~ school)|trans }}</span>
                </div>
                <div class="hero-mastery-row__progress">
                    <div class="ui-progress ui-progress--compact hero-mastery-row__bar-track">
                        <div class="ui-progress__fill ui-progress__fill--accent" style="--ui-progress-pct: {{ progress_pct }}%"></div>
                    </div>
                    <span class="hero-mastery-row__pct">{{ progress_pct }}%</span>
                </div>
                <div class="hero-mastery-row__meta">
                    {% if mastery_tier == 5 %}
                        <span>{{ 'heroes.mastery_xp_max'|trans }}</span>
                    {% else %}
                        <span>{{ relative_xp }}/{{ relative_req }} XP</span>
                    {% endif %}
                    <span class="hero-mastery-row__tier">T{{ mastery_tier }}</span>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if active_count < school_list|length %}
        <div class="layout-cluster layout-cluster--center">
            <button type="button" class="btn btn-outline btn--sm btn--spaced-top" data-action="click->mastery-toggle#toggle"
                    data-toggle-text="{{ 'heroes.btn_hide_inactive_masteries'|trans }}">
                {{ 'heroes.btn_show_all_masteries'|trans }}
            </button>
        </div>
    {% endif %}
</div>
